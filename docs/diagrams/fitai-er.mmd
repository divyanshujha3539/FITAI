        smallint RepsMaximum
        smallint RestSeconds
    }
    WORKOUT_SESSIONS {
        bigint WorkoutSessionId PK
        nvarchar UserId FK
        bigint WorkoutPlanId FK
        date SessionDate
        varchar SessionStatus
    }
    WORKOUT_LOGS {
        bigint WorkoutLogId PK
        bigint WorkoutSessionId FK
        nvarchar UserId FK
        bigint ExerciseId FK
        nvarchar ExerciseNameSnapshot
        smallint Position
