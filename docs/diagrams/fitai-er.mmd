        bigint WorkoutPlanId PK
        nvarchar UserId FK
        nvarchar PlanName
        tinyint DaysPerWeek
        varchar ExperienceLevel
    }
    WORKOUT_PLAN_DAYS {
        bigint WorkoutPlanDayId PK
        bigint WorkoutPlanId FK
        nvarchar UserId FK
        tinyint PlanDayNumber
        nvarchar DayName
    }
    WORKOUT_PLAN_EXERCISES {
        bigint WorkoutPlanExerciseId PK
        bigint WorkoutPlanDayId FK
        nvarchar UserId FK
