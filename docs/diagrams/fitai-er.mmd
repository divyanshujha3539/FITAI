    USERS {
        nvarchar UserId PK
        nvarchar Email UK
        datetime2 CreatedAtUtc
        varchar AccountStatus
    }
    USER_IDENTITIES {
        bigint UserIdentityId PK
        nvarchar UserId FK
        varchar Provider
        nvarchar ProviderSubject
    }
    USER_PROFILES {
        nvarchar UserId PK,FK
        varchar FitnessGoal
        decimal DailyFoodBudget
        decimal HeightCm
        decimal WeightKg
    }
    DIETARY_PREFERENCES {
        varchar PreferenceCode PK
        nvarchar PreferenceName UK
    }
    USER_DIETARY_PREFERENCES {
        nvarchar UserId PK,FK
        varchar PreferenceCode PK,FK
    }
    USER_NUTRITION_TARGETS {
        bigint UserNutritionTargetId PK
        nvarchar UserId FK
        date EffectiveFrom
        decimal CaloriesKcal
        decimal ProteinGrams
    }
    FOOD_CATEGORIES {
        int FoodCategoryId PK
        varchar CategoryCode UK
        nvarchar CategoryName UK
    }
    FOODS {
        bigint FoodId PK
        int FoodCategoryId FK
        nvarchar FoodName UK
        nvarchar SearchName
        bit IsActive
    }
    FOOD_ALIASES {
        bigint FoodAliasId PK
        bigint FoodId FK
        nvarchar Alias
        nvarchar SearchName
        varchar LanguageCode
    }
    FOOD_SERVING_CONVERSIONS {
        bigint FoodServingConversionId PK
        bigint FoodId FK
        nvarchar ServingName
        decimal EquivalentAmount
        varchar EquivalentUnit
        varchar EvidenceStatus
        nvarchar SourceName
    }
    FOOD_NUTRITION {
        bigint FoodId PK,FK
        decimal ReferenceAmount
        varchar ReferenceUnit
        decimal CaloriesKcal
        decimal ProteinGrams
        varchar EvidenceStatus
        nvarchar SourceName
    }
    FOOD_PRICES {
        bigint FoodPriceId PK
        bigint FoodId FK
        decimal PriceAmount
        decimal QuantityAmount
        varchar QuantityUnit
        varchar EvidenceStatus
        nvarchar SourceName
        date ObservedOn
    }
    MEALS {
        bigint MealId PK
        nvarchar UserId FK
        date MealDate
        varchar MealType
        nvarchar Notes
    }
    MEAL_ITEMS {
        bigint MealItemId PK
        bigint MealId FK
        nvarchar UserId FK
        bigint FoodId FK
        nvarchar FoodNameSnapshot
        decimal ServingAmount
        varchar ServingUnit
        decimal CaloriesKcal
        decimal ProteinGrams
        nvarchar NutritionSourceSnapshot
        nvarchar NutritionSourceUrlSnapshot
    }
